---
/*
  An ADE session. The point the diagram has to make: the agent does not reach the
  provider directly — it goes through the gateway, so budgets and rate limits apply to
  candidate traffic, and the credential is scoped to the single session.

  Colours come from CSS custom properties so the diagram re-themes with the page
  instead of needing a second copy for dark mode.
*/
---

<svg viewBox="0 0 460 300" role="img" aria-labelledby="ade-t ade-d">
  <title id="ade-t">Architecture of an ADE candidate session</title>
  <desc id="ade-d">
    A candidate connects to a workspace VM containing an editor, a terminal and a coding
    agent. The agent's requests leave the VM to an LLM gateway which enforces budget and
    rate limits, and only then reach the Anthropic API. A per-session credential is
    minted for the workspace by the platform backend.
  </desc>

  <defs>
    <marker id="ade-arrow" viewBox="0 0 10 10" refX="9" refY="5"
      markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" fill="var(--fg-faint)" />
    </marker>
  </defs>

  <g fill="var(--fg)" font-family="var(--mono)" font-size="11">
    <!-- candidate -->
    <rect x="163" y="6" width="134" height="30" rx="15"
      fill="none" stroke="var(--fg-faint)" stroke-width="1" />
    <text x="230" y="25" text-anchor="middle">candidate</text>

    <line x1="230" y1="36" x2="230" y2="58" stroke="var(--fg-faint)"
      marker-end="url(#ade-arrow)" />

    <!-- workspace VM -->
    <rect x="38" y="58" width="384" height="104" rx="6"
      fill="var(--accent-wash)" stroke="var(--accent)" stroke-width="1" />
    <text x="52" y="78" font-size="10" fill="var(--fg-muted)" letter-spacing="1">
      WORKSPACE VM
    </text>

    <g stroke="var(--rule)" fill="var(--bg)">
      <rect x="54" y="90" width="104" height="30" rx="4" />
      <rect x="178" y="90" width="104" height="30" rx="4" />
      <rect x="302" y="90" width="104" height="30" rx="4" />
    </g>
    <text x="106" y="109" text-anchor="middle">editor</text>
    <text x="230" y="109" text-anchor="middle">terminal</text>
    <text x="354" y="109" text-anchor="middle">agent</text>

    <text x="54" y="146" font-size="10" fill="var(--fg-muted)">
      editor + agent set up in parallel
    </text>

    <!-- agent egress -->
    <line x1="354" y1="120" x2="354" y2="140" stroke="var(--fg-faint)" />
    <path d="M354 140 L354 176 L230 176 L230 194" fill="none" stroke="var(--fg-faint)"
      marker-end="url(#ade-arrow)" />

    <!-- gateway -->
    <rect x="86" y="194" width="288" height="44" rx="6"
      fill="none" stroke="var(--fg)" stroke-width="1.5" />
    <text x="230" y="212" text-anchor="middle" font-weight="600">LLM gateway</text>
    <text x="230" y="228" text-anchor="middle" font-size="10" fill="var(--fg-muted)">
      budget · TPM · RPM · cost attribution
    </text>

    <line x1="230" y1="238" x2="230" y2="262" stroke="var(--fg-faint)"
      marker-end="url(#ade-arrow)" />

    <!-- provider -->
    <rect x="150" y="262" width="160" height="30" rx="4"
      fill="none" stroke="var(--fg-faint)" stroke-dasharray="3 3" />
    <text x="230" y="281" text-anchor="middle" fill="var(--fg-muted)">Anthropic API</text>

    <!-- Per-session credential. The label sits below the arrow's horizontal run, in the
         clear space left of the gateway — there is not enough left margin to label it
         beside the VM without colliding with the editor box. -->
    <path d="M38 110 L14 110 L14 216 L86 216" fill="none" stroke="var(--accent)"
      stroke-width="1" stroke-dasharray="4 3" marker-end="url(#ade-arrow)" />
    <text x="6" y="232" font-size="9" fill="var(--accent)">credential</text>
    <text x="6" y="243" font-size="9" fill="var(--accent)">per session</text>
  </g>
</svg>
