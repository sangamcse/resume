---
/*
  Two stacks becoming one. The detail that matters is what got deleted, so the retired
  components are drawn struck through rather than simply omitted — the diagram should
  show the cost that was being paid, not just the tidy end state.
*/
---

<svg viewBox="0 0 460 320" role="img" aria-labelledby="cons-t cons-d">
  <title id="cons-t">Consolidating a bespoke provisioning stack into the shared platform</title>
  <desc id="cons-d">
    Before: DevOps assessments ran on a bespoke stack with its own EC2 provisioning, cron
    jobs, background workers, Redis and EKS cluster, in parallel with the shared workspace
    service used by every other product. After: all traffic runs through the shared
    multi-cloud workspace service, and the bespoke stack, its cluster, Redis, nine cron
    jobs and six workers were shut down. Historical reports still resolve.
  </desc>

  <defs>
    <marker id="cons-arrow" viewBox="0 0 10 10" refX="9" refY="5"
      markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" fill="var(--fg-faint)" />
    </marker>
  </defs>

  <g font-family="var(--mono)" font-size="10" fill="var(--fg)">
    <!-- ============ BEFORE ============ -->
    <text x="8" y="14" fill="var(--fg-muted)" letter-spacing="1">BEFORE</text>

    <rect x="8" y="24" width="196" height="20" rx="3"
      fill="none" stroke="var(--rule)" />
    <text x="106" y="38" text-anchor="middle" fill="var(--fg-muted)">
      assessment · interview · pair
    </text>

    <path d="M60 44 L60 60" fill="none" stroke="var(--fg-faint)" marker-end="url(#cons-arrow)" />
    <path d="M152 44 L152 60" fill="none" stroke="var(--fg-faint)" marker-end="url(#cons-arrow)" />

    <!-- bespoke stack -->
    <rect x="8" y="60" width="96" height="118" rx="5"
      fill="none" stroke="var(--fg-faint)" stroke-dasharray="4 3" />
    <text x="56" y="76" text-anchor="middle" font-size="9" fill="var(--fg-muted)">bespoke</text>
    <g stroke="var(--rule)" fill="var(--bg)">
      <rect x="16" y="84" width="80" height="18" rx="2" />
      <rect x="16" y="106" width="80" height="18" rx="2" />
      <rect x="16" y="128" width="80" height="18" rx="2" />
      <rect x="16" y="150" width="80" height="18" rx="2" />
    </g>
    <g text-anchor="middle" fill="var(--fg-muted)" font-size="9">
      <text x="56" y="96">EC2 direct</text>
      <text x="56" y="118">9 crons</text>
      <text x="56" y="140">6 workers</text>
      <text x="56" y="162">EKS · Redis</text>
    </g>

    <!-- shared stack -->
    <rect x="112" y="60" width="92" height="118" rx="5"
      fill="none" stroke="var(--rule)" />
    <text x="158" y="76" text-anchor="middle" font-size="9" fill="var(--fg-muted)">shared</text>
    <rect x="120" y="84" width="76" height="18" rx="2" stroke="var(--rule)" fill="var(--bg)" />
    <text x="158" y="96" text-anchor="middle" font-size="9" fill="var(--fg-muted)">
      workspace svc
    </text>

    <text x="8" y="198" fill="var(--fg-faint)">every feature built twice</text>
    <text x="8" y="211" fill="var(--fg-faint)">warm capacity paid twice</text>

    <!-- divider -->
    <line x1="230" y1="20" x2="230" y2="300" stroke="var(--rule)" stroke-dasharray="2 4" />

    <!-- ============ AFTER ============ -->
    <text x="256" y="14" fill="var(--accent)" letter-spacing="1">AFTER</text>

    <rect x="256" y="24" width="196" height="20" rx="3"
      fill="none" stroke="var(--rule)" />
    <text x="354" y="38" text-anchor="middle" fill="var(--fg-muted)">
      assessment · interview · pair
    </text>

    <path d="M354 44 L354 62" fill="none" stroke="var(--accent)" marker-end="url(#cons-arrow)" />

    <rect x="284" y="62" width="140" height="44" rx="5"
      fill="var(--accent-wash)" stroke="var(--accent)" stroke-width="1.5" />
    <text x="354" y="80" text-anchor="middle" font-size="11" font-weight="600">
      workspace service
    </text>
    <text x="354" y="94" text-anchor="middle" fill="var(--fg-muted)">AWS · GCP</text>

    <path d="M354 106 L354 124" fill="none" stroke="var(--fg-faint)"
      marker-end="url(#cons-arrow)" />
    <rect x="284" y="124" width="140" height="20" rx="3"
      fill="none" stroke="var(--fg-faint)" stroke-dasharray="3 3" />
    <text x="354" y="138" text-anchor="middle" fill="var(--fg-muted)">candidate workspaces</text>

    <!-- what was deleted -->
    <text x="256" y="176" fill="var(--fg-muted)" font-size="9" letter-spacing="1">
      SHUT DOWN
    </text>
    <g fill="var(--fg-faint)" font-size="9">
      <text x="256" y="192">EKS cluster</text>
      <text x="256" y="205">managed Redis</text>
      <text x="256" y="218">9 cron jobs</text>
      <text x="256" y="231">6 background workers</text>
    </g>
    <g stroke="var(--fg-faint)" stroke-width="0.9">
      <line x1="254" y1="189" x2="322" y2="189" />
      <line x1="254" y1="202" x2="336" y2="202" />
      <line x1="254" y1="215" x2="314" y2="215" />
      <line x1="254" y1="228" x2="362" y2="228" />
    </g>

    <text x="256" y="256" fill="var(--accent)">no data migrated</text>
    <text x="256" y="269" fill="var(--accent)">historical reports still resolve</text>
  </g>
</svg>
